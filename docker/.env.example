# CockroachDB + Airflow PoC — Environment Configuration
#
# Copy this file to `.env` (in the same directory) before running
# `docker compose up -d`. Override any of these in your shell or a
# local `.env.local` file.

# --- CockroachDB ---
COCKROACHDB_VERSION=v25.4.10
COCKROACHDB_SQL_PORT=26257
COCKROACHDB_UI_PORT=8081
AIRFLOW_METADATA_DB=airflow

# --- Apache Airflow ---
AIRFLOW_VERSION=3.2.1
AIRFLOW_PYTHON_VERSION=3.12
AIRFLOW_WEBSERVER_PORT=8080
AIRFLOW_EXECUTOR=LocalExecutor
AIRFLOW_LOAD_EXAMPLES=false
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_ADMIN_EMAIL=admin@example.com

# --- SQLAlchemy CockroachDB Adapter ---
# Airflow 3.x requires SQLAlchemy 2.0+, so we need sqlalchemy-cockroachdb 2.0+
SQLALCHEMY_COCKROACHDB_VERSION=2.0.4
PSYCOPG2_VERSION=2.9
# Airflow 3.x requires an async driver for its async SQLAlchemy engine
ASYNCPG_VERSION=0.30

# --- Logging ---
AIRFLOW_LOGGING_LEVEL=INFO
